---
interface Props {
  lang?: 'en' | 'pl';
  overlay?: boolean;
}

const { lang = 'en', overlay = false } = Astro.props;

const navItems = lang === 'en'
  ? [
      { label: 'Practice', href: '/en/practice/' },
      { label: 'Governance', href: '/en/governance/' },
      { label: 'Academia', href: '/en/academia/' },
      { label: 'Media', href: '/en/media/' },
      { label: 'AnyLawyer.com', href: '/en/startup/' },
      { label: 'Contact', href: '/en/contact/' },
    ]
  : [
      { label: 'Praktyka', href: '/pl/praktyka/' },
      { label: 'Governance', href: '/pl/governance/' },
      { label: 'Nauka', href: '/pl/nauka/' },
      { label: 'Media', href: '/pl/media/' },
      { label: 'AnyLawyer.com', href: '/pl/startup/' },
      { label: 'Kontakt', href: '/pl/kontakt/' },
    ];
const isActive = (href: string) => Astro.url.pathname.startsWith(href);

const currentPath = Astro.url.pathname;

// Map of EN paths to PL paths (and vice versa can be derived)
const enToPlMapping: Record<string, string> = {
  '/en/academia': '/pl/nauka',
  '/en/practice': '/pl/praktyka',
  '/en/contact': '/pl/kontakt',
  '/en/privacy': '/pl/prywatnosc',
};

const plToEnMapping: Record<string, string> = {
  '/pl/nauka': '/en/academia',
  '/pl/praktyka': '/en/practice',
  '/pl/kontakt': '/en/contact',
  '/pl/prywatnosc': '/en/privacy',
};

// Get alternate language URL
function getAlternateUrl(path: string, targetLang: 'en' | 'pl', currentLang: 'en' | 'pl'): string {
  // Remove trailing slash for lookup
  const cleanPath = path.replace(/\/$/, '');

  // If target is same as current, return current path
  if (targetLang === currentLang) {
    return path.endsWith('/') ? path : path + '/';
  }

  // Check if we have a custom mapping
  if (currentLang === 'en' && enToPlMapping[cleanPath]) {
    return enToPlMapping[cleanPath] + '/';
  }
  if (currentLang === 'pl' && plToEnMapping[cleanPath]) {
    return plToEnMapping[cleanPath] + '/';
  }

  // Default: simple language prefix swap
  const pathWithoutLang = cleanPath.replace(/^\/(en|pl)/, '');
  return `/${targetLang}${pathWithoutLang}/`;
}

const enUrl = getAlternateUrl(currentPath, 'en', lang);
const plUrl = getAlternateUrl(currentPath, 'pl', lang);
---

<header class:list={[
  "z-50 w-full",
  overlay ? "absolute top-0 left-0 bg-transparent" : "sticky top-0 bg-[#0c1424] border-b border-[#22304b]"
]}>
  <div class="max-w-[1200px] mx-auto px-5 md:px-8">
    <div class="flex items-center justify-between h-20">
      <a href={`/${lang}/`} class="font-display text-[20px] text-[#eef1f6] hover:text-gold transition-colors">
        Michał Jackowski
      </a>

      <nav class="hidden lg:flex items-center gap-7">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "text-sm transition-colors",
              isActive(item.href) ? "text-gold" : "text-[#c9d1df] hover:text-gold"
            ]}
          >
            {item.label}
          </a>
        ))}
        <span class="flex items-center gap-2 ml-2 text-sm">
          <a href={enUrl} class:list={[lang === 'en' ? "text-gold" : "text-[#93a0b8] hover:text-gold", "transition-colors"]}>EN</a>
          <span class="text-[#3a4a6a]">/</span>
          <a href={plUrl} class:list={[lang === 'pl' ? "text-gold" : "text-[#93a0b8] hover:text-gold", "transition-colors"]}>PL</a>
        </span>
      </nav>

      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-[#eef1f6]"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="lg:hidden hidden bg-[#0c1424] border-b border-[#22304b]">
    <div class="px-5 py-4 space-y-1">
      {navItems.map((item) => (
        <a href={item.href} class="block text-[#eef1f6] hover:text-gold transition-colors text-base py-2">
          {item.label}
        </a>
      ))}
      <div class="flex items-center gap-3 pt-4 mt-2 border-t border-[#22304b] text-sm">
        <a href={enUrl} class:list={[lang === 'en' ? "text-gold" : "text-[#93a0b8]"]}>EN</a>
        <a href={plUrl} class:list={[lang === 'pl' ? "text-gold" : "text-[#93a0b8]"]}>PL</a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (function() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (btn && menu && iconOpen && iconClose) {
      btn.addEventListener('click', function() {
        const isOpen = !menu.classList.contains('hidden');

        if (isOpen) {
          menu.classList.add('hidden');
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        } else {
          menu.classList.remove('hidden');
          iconOpen.classList.add('hidden');
          iconClose.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    }
  })();
</script>
